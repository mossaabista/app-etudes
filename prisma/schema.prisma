generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses     Course[]
  tasks       Task[]
  projects    Project[]
  assessments Assessment[]
  events      CalendarEvent[]
  syllabi     Syllabus[]
  labs        LabSession[]
  syncSources SyncSource[]
  pushSubs    PushSubscription[]
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  // The push service URL Apple/Google hands out; unique per device install.
  endpoint   String    @unique
  p256dh     String
  auth       String
  label      String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SyncSource {
  id           String    @id @default(cuid())
  userId       String
  provider     String    @default("brightspace")
  feedUrl      String
  active       Boolean   @default(true)
  lastSyncedAt DateTime?
  lastStatus   String?   // ok, error
  lastMessage  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model Course {
  id        String   @id @default(cuid())
  userId    String
  code      String
  name      String
  professor String?
  email     String?
  room      String?
  color     String   @default("#3b82f6")
  term      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules   CourseSchedule[]
  assessments Assessment[]
  tasks       Task[]
  projects    Project[]
  syllabi     Syllabus[]
  events      CalendarEvent[]
  labs        LabSession[]
}

model CourseSchedule {
  id        String @id @default(cuid())
  courseId   String
  type      String // Lecture, Tutorial, Lab
  day       String // Monday, Tuesday, etc.
  startTime String // "08:30"
  endTime   String // "09:50"
  room      String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Syllabus {
  id         String   @id @default(cuid())
  userId     String
  courseId    String
  fileName   String
  fileUrl    String
  parsed     Boolean  @default(false)
  rawData    Json?
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Assessment {
  id        String   @id @default(cuid())
  userId    String
  courseId   String
  title     String
  type      String   // Assignment, Quiz, Midterm, Final, Lab, Project, Presentation, Report
  weight    Float?
  dueDate   DateTime?
  status    String   @default("Upcoming") // Upcoming, Completed, Overdue
  grade     Float?
  notes     String?
  source      String?  // brightspace, or null when created manually
  externalUid String?  // iCal UID, used to match on re-sync
  externalUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tasks  Task[]

  @@unique([userId, externalUid])
}

model Task {
  id            String    @id @default(cuid())
  userId        String
  courseId       String?
  projectId     String?
  assessmentId  String?
  parentId      String?
  title         String
  description   String?
  status        String    @default("ToDo") // ToDo, InProgress, Done, Deferred
  priority      String    @default("Medium") // Low, Medium, High, Critical
  dueDate       DateTime?
  estimatedTime Int?      // minutes
  category      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assessment Assessment?  @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  parent     Task?        @relation("SubTasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks   Task[]       @relation("SubTasks")
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  courseId     String?
  title       String
  description String?
  status      String    @default("InProgress") // NotStarted, InProgress, Completed
  dueDate     DateTime?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  tasks      Task[]
  milestones ProjectMilestone[]
  members    ProjectMember[]
}

model ProjectMilestone {
  id        String    @id @default(cuid())
  projectId String
  title     String
  dueDate   DateTime?
  status    String    @default("Pending") // Pending, Completed
  sortOrder Int       @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  name      String
  email     String?
  role      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id        String    @id @default(cuid())
  userId    String
  courseId   String?
  title     String
  type      String    // CourseLecture, CourseLab, CourseTutorial, Deadline, Meeting, Personal
  date      DateTime
  startTime String?
  endTime   String?
  allDay    Boolean   @default(false)
  notes     String?
  source      String?
  externalUid String?
  externalUrl String?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([userId, externalUid])
}

model LabSession {
  id          String    @id @default(cuid())
  userId      String
  courseId     String
  labNumber   Int
  title       String
  date        DateTime?
  room        String?
  topic       String?
  deliverable String?
  dueDate     DateTime?
  status      String    @default("Upcoming") // Upcoming, Completed, Submitted, Overdue
  grade       Float?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
