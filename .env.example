# Obligatoires
DATABASE_URL=            # Postgres (Neon) — chaîne de connexion
SESSION_SECRET=          # 32 caractères aléatoires ou plus : signe les sessions et les confirmations

# Assistant intelligent (facultatif : sans clé, le parseur à règles prend le relais)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=         # défaut : claude-haiku-4-5-20251001 (voir docs/DEPLOYMENT.md avant de changer)

# Notifications push (facultatif) — npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=           # mailto:toi@exemple.com

# Tâches planifiées Vercel (synchro, résumé du matin, automatisations)
CRON_SECRET=

# Développement local seulement (voir docs/DEV_LOCAL.md)
# LOCAL_PG_WS_PROXY=
